{
  "expo": {
    "name": "Densa Deck",
    "slug": "densa-deck-companion",
    "version": "0.19.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.densanon.densadeck",
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 62,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7F9"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-camera",
      "./plugins/with-immersive.cjs",
      "./plugins/with-cleartext.cjs"
    ],
    "icon": "./assets/icon.png"
  }
}
